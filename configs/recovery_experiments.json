{
  "description": "Controlled recovery experiments on existing development scenes; no new held-out claim",
  "defaults": {
    "max_dimension": 1600,
    "max_features": 6000,
    "window": 2,
    "long_gap": 4,
    "seed": 0,
    "local_ba": true
  },
  "cases": [
    {
      "name": "castle_graph",
      "split": "development",
      "input": "datasets/sceaux/images",
      "camera": "configs/sceaux.json",
      "cache_tag": "castle_graph",
      "settings": {
        "recovery_pairs": 12
      }
    },
    {
      "name": "castle_joint",
      "split": "development",
      "input": "datasets/sceaux/images",
      "camera": "configs/sceaux.json",
      "cache_tag": "castle_joint",
      "settings": {
        "joint_ba": true
      }
    },
    {
      "name": "castle_combined",
      "split": "development",
      "input": "datasets/sceaux/images",
      "camera": "configs/sceaux.json",
      "cache_tag": "castle_combined",
      "settings": {
        "recovery_pairs": 12,
        "joint_ba": true
      }
    },
    {
      "name": "temple15_graph",
      "split": "development",
      "input": "datasets/temple/images15",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple15_graph",
      "settings": {
        "recovery_pairs": 12
      }
    },
    {
      "name": "temple15_joint",
      "split": "development",
      "input": "datasets/temple/images15",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple15_joint",
      "settings": {
        "joint_ba": true
      }
    },
    {
      "name": "temple15_combined",
      "split": "development",
      "input": "datasets/temple/images15",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple15_combined",
      "settings": {
        "recovery_pairs": 12,
        "joint_ba": true
      }
    },
    {
      "name": "temple30_graph",
      "split": "development",
      "input": "datasets/temple/images30",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple30_graph",
      "settings": {
        "recovery_pairs": 12
      }
    },
    {
      "name": "temple30_joint",
      "split": "development",
      "input": "datasets/temple/images30",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple30_joint",
      "settings": {
        "joint_ba": true
      }
    },
    {
      "name": "temple30_combined",
      "split": "development",
      "input": "datasets/temple/images30",
      "camera": "datasets/temple/cameras.json",
      "reference": "datasets/temple/reference_poses.json",
      "cache_tag": "temple30_combined",
      "settings": {
        "recovery_pairs": 12,
        "joint_ba": true
      }
    }
  ]
